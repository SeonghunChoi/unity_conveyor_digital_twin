/*
  ISA-101 (고성능 HMI) 원칙에 따른 색 체계
  - 배경·정상값: 회색 계열 (눈에 띄지 않게)
  - 경고: 주황 / 중대: 빨강 / 안내: 파랑. 색은 이상 상태에만 쓴다
  - 정상 운전 범위는 막대 위 옅은 띠로 보여 값이 범위 안인지 한눈에 알게 한다
*/
.root {
    flex-grow: 1;
    padding: 12px;
    color: rgb(222, 226, 230);
    font-size: 15px;
}

/* ---------- 상단 바 ---------- */
.topbar {
    flex-direction: row;
    align-items: center;
    height: 64px;
    padding: 0 16px;
    background-color: rgba(30, 34, 38, 0.92);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(58, 63, 68);
}
.title-block { width: 380px; }
.title { font-size: 22px; -unity-font-style: bold; color: rgb(240, 242, 244); }
.subtitle { font-size: 13px; color: rgb(140, 146, 152); }
.chips { flex-direction: row; flex-grow: 1; justify-content: center; }
.chip {
    flex-direction: column;
    min-width: 150px;
    margin: 0 6px;
    padding: 4px 12px;
    border-radius: 4px;
    background-color: rgb(42, 47, 52);
    border-left-width: 4px;
    border-color: rgb(90, 96, 102);
}
.chip-label { font-size: 12px; color: rgb(140, 146, 152); }
.chip-value { font-size: 15px; -unity-font-style: bold; }
.chip.ok { border-color: rgb(110, 118, 126); }
.chip.warn { border-color: rgb(255, 170, 40); background-color: rgb(70, 54, 24); }
.chip.bad { border-color: rgb(240, 70, 60); background-color: rgb(82, 30, 28); }
.clock-block { flex-direction: row; align-items: center; width: 220px; justify-content: flex-end; }
.clock { font-size: 20px; margin-right: 12px; color: rgb(200, 205, 210); }

.btn {
    background-color: rgb(52, 58, 64);
    color: rgb(222, 226, 230);
    border-width: 1px;
    border-color: rgb(80, 86, 92);
    border-radius: 4px;
    padding: 4px 14px;
    font-size: 14px;
}
.btn:hover { background-color: rgb(66, 73, 80); }
.btn.active { background-color: rgb(40, 88, 140); border-color: rgb(70, 130, 200); }

/* ---------- 본문 ---------- */
.body { flex-direction: row; flex-grow: 1; margin-top: 12px; }
.column { width: 360px; }
.column.right { width: 440px; }
.center { flex-grow: 1; justify-content: flex-end; align-items: center; padding-bottom: 24px; }

.card {
    background-color: rgba(30, 34, 38, 0.90);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(58, 63, 68);
    padding: 10px 14px;
    margin-bottom: 10px;
}
.card-title { font-size: 13px; color: rgb(150, 156, 162); -unity-font-style: bold; }
.muted { font-size: 13px; color: rgb(130, 136, 142); white-space: normal; }

/* 운전 상태 */
.run-state { font-size: 30px; -unity-font-style: bold; margin: 2px 0; color: rgb(220, 224, 228); }
.run-card.fault { border-color: rgb(240, 70, 60); background-color: rgba(82, 30, 28, 0.92); }
.run-card.fault .run-state { color: rgb(255, 120, 110); }
.run-card.unknown .run-state { color: rgb(140, 146, 152); }

/* 측정값 카드 */
.kpi-head { flex-direction: row; justify-content: space-between; }
.kpi-meta { font-size: 12px; color: rgb(120, 126, 132); }
.kpi-value-row { flex-direction: row; align-items: flex-end; }
.kpi-value { font-size: 34px; -unity-font-style: bold; color: rgb(230, 233, 236); }
.kpi-unit { font-size: 15px; color: rgb(140, 146, 152); margin-left: 4px; margin-bottom: 6px; }
.kpi.warn { border-color: rgb(255, 170, 40); }
.kpi.warn .kpi-value { color: rgb(255, 190, 90); }
.kpi.bad { border-color: rgb(240, 70, 60); }
.kpi.bad .kpi-value { color: rgb(255, 120, 110); }
.kpi.stale .kpi-value { color: rgb(110, 116, 122); }

/* 막대: 회색 바탕 + 정상 범위 띠 + 현재값 */
.bar {
    height: 8px;
    margin: 4px 0 6px 0;
    background-color: rgb(48, 53, 58);
    border-radius: 2px;
    overflow: hidden;
}
.bar-band { position: absolute; top: 0; bottom: 0; background-color: rgb(78, 86, 94); }
.bar-fill { position: absolute; top: 2px; bottom: 2px; width: 3px; background-color: rgb(225, 229, 233); }
.kpi.warn .bar-fill { background-color: rgb(255, 170, 40); }
.kpi.bad .bar-fill { background-color: rgb(240, 70, 60); }

.trend { height: 54px; background-color: rgb(36, 40, 44); border-radius: 3px; }

/* 물건 추적 */
.stat-grid { flex-direction: row; flex-wrap: wrap; margin-top: 4px; }
.stat { width: 50%; margin-bottom: 6px; }
.stat-label { font-size: 12px; color: rgb(130, 136, 142); }
.stat-value { font-size: 26px; -unity-font-style: bold; color: rgb(230, 233, 236); }
.stat-value.small { font-size: 18px; }

/* 알람 */
.alarms { flex-grow: 1; }
.alarm-head { flex-direction: row; align-items: center; }
.alarm-counts { flex-grow: 1; margin-left: 10px; font-size: 13px; color: rgb(150, 156, 162); }
.btn-ack.hidden { display: none; }
.alarm-list { margin-top: 6px; }
.alarm-empty.hidden { display: none; }
.alarm-row {
    flex-direction: row;
    padding: 6px 8px;
    margin-bottom: 4px;
    border-radius: 3px;
    border-left-width: 5px;
    background-color: rgb(40, 44, 48);
}
.alarm-row.critical { border-color: rgb(240, 70, 60); }
.alarm-row.warning { border-color: rgb(255, 170, 40); }
.alarm-row.info { border-color: rgb(90, 160, 230); }
/* 활성·미확인: 배경 점멸 (TwinHmi.cs가 blink 클래스를 토글) */
.alarm-row.critical.blink { background-color: rgb(96, 32, 30); }
.alarm-row.warning.blink { background-color: rgb(86, 64, 24); }
.alarm-row.cleared { background-color: rgb(34, 37, 40); }
.alarm-row.cleared .alarm-text { color: rgb(120, 126, 132); }
.alarm-tag { width: 38px; font-size: 12px; -unity-font-style: bold; }
.alarm-row.critical .alarm-tag { color: rgb(255, 110, 100); }
.alarm-row.warning .alarm-tag { color: rgb(255, 190, 90); }
.alarm-row.info .alarm-tag { color: rgb(130, 190, 250); }
.alarm-body { flex-grow: 1; flex-shrink: 1; }
.alarm-text { font-size: 14px; white-space: normal; color: rgb(225, 228, 232); }
.alarm-meta { font-size: 11px; color: rgb(120, 126, 132); }

/* 서버 칩 안의 실행 버튼 */
.chip-with-action { flex-direction: row; align-items: center; justify-content: space-between; }
.btn-small { padding: 2px 10px; font-size: 13px; margin-left: 8px; }
.btn-small.hidden { display: none; }
.btn-primary { background-color: rgb(40, 88, 140); border-color: rgb(70, 130, 200); }
.btn-primary:hover { background-color: rgb(52, 104, 162); }

/* 다이얼로그 */
.overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.45);
    justify-content: center;
    align-items: center;
}
.overlay.hidden { display: none; }
.dialog {
    width: 560px;
    padding: 20px 24px;
    background-color: rgb(34, 38, 42);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(240, 70, 60);
}
.dialog-title { font-size: 20px; -unity-font-style: bold; color: rgb(255, 130, 120); margin-bottom: 8px; }
.dialog-body { font-size: 15px; white-space: normal; margin-bottom: 10px; color: rgb(222, 226, 230); }
.dialog-note { margin-bottom: 14px; }
.dialog-buttons { flex-direction: row; justify-content: flex-end; }
.dialog-buttons .btn { margin-left: 10px; padding: 6px 18px; font-size: 15px; }

/* 가운데 안내 배너 */
.banner {
    padding: 10px 22px;
    border-radius: 6px;
    background-color: rgba(30, 34, 38, 0.92);
    border-width: 1px;
    border-color: rgb(58, 63, 68);
}
.banner.hidden { display: none; }
.banner.bad { border-color: rgb(240, 70, 60); background-color: rgba(82, 30, 28, 0.92); }
.banner.warn { border-color: rgb(255, 170, 40); background-color: rgba(70, 54, 24, 0.92); }
.banner.info { border-color: rgb(90, 160, 230); background-color: rgba(26, 48, 72, 0.92); }
.banner-text { font-size: 18px; -unity-font-style: bold; -unity-text-align: middle-center; }
