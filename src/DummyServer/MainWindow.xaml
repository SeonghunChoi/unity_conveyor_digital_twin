<Window x:Class="ConveyorTwin.DummyServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ConveyorTwin.DummyServer"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance local:MainViewModel}"
        Title="Conveyor01 Dummy Server" Height="720" Width="1180"
        FontFamily="Malgun Gothic" FontSize="13">
    <Window.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Margin" Value="0,0,8,2"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,24,0"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <!-- 브로커·세션 상태 -->
        <Border DockPanel.Dock="Top" Background="#F3F5F7" Padding="10" CornerRadius="4">
            <WrapPanel>
                <StackPanel><TextBlock Style="{StaticResource Caption}" Text="브로커"/>
                    <TextBlock Style="{StaticResource Value}"><Run Text="{Binding BrokerEndpoint, Mode=OneWay}"/> <Run Text="{Binding BrokerStatus, Mode=OneWay}"/></TextBlock></StackPanel>
                <StackPanel><TextBlock Style="{StaticResource Caption}" Text="세션 ID (sid)"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding Sid, Mode=OneWay}"/></StackPanel>
                <StackPanel><TextBlock Style="{StaticResource Caption}" Text="접속 클라이언트"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding ClientsText}"/></StackPanel>
                <StackPanel><TextBlock Style="{StaticResource Caption}" Text="로봇 OPC UA"/>
                    <TextBlock Style="{StaticResource Value}"><Run Text="{Binding OpcUaEndpoint, Mode=OneWay}"/> <Run Text="{Binding OpcUaStatus, Mode=OneWay}"/></TextBlock></StackPanel>
                <StackPanel><TextBlock Style="{StaticResource Caption}" Text="OPC UA 세션"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding OpcUaSessionsText}"/></StackPanel>
            </WrapPanel>
        </Border>

        <!-- 가상 설비 현재값 (서버가 "현실"로서 가진 값) -->
        <Border DockPanel.Dock="Top" Margin="0,8,0,8" BorderBrush="#DDD" BorderThickness="1" Padding="10" CornerRadius="4">
            <WrapPanel>
                <StackPanel><TextBlock Style="{StaticResource Caption}" Text="가동 상태"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding RunStateText}"/></StackPanel>
                <StackPanel><TextBlock Style="{StaticResource Caption}" Text="벨트 속도"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding SpeedText}"/></StackPanel>
                <StackPanel><TextBlock Style="{StaticResource Caption}" Text="모터 온도"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding TempText}"/></StackPanel>
                <StackPanel><TextBlock Style="{StaticResource Caption}" Text="모터 전류"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding CurrentText}"/></StackPanel>
                <StackPanel><TextBlock Style="{StaticResource Caption}" Text="물건"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding ItemsText}"/></StackPanel>
                <StackPanel><TextBlock Style="{StaticResource Caption}" Text="로봇 (단계 · 사이클 · 팔레트)"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding RobotText}"/></StackPanel>
                <StackPanel><TextBlock Style="{StaticResource Caption}" Text="관절각 J1~J6 [°]"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding JointsText}"/></StackPanel>
            </WrapPanel>
        </Border>

        <!-- 장애 버튼: 장애는 현실(서버) 쪽에서 일어나고 트윈은 대응만 한다 -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,8" BorderBrush="#E8B4B4" Background="#FFF7F7" BorderThickness="1" Padding="10" CornerRadius="4">
            <StackPanel>
                <TextBlock Style="{StaticResource Caption}" Text="장애 주입 (누르면 켜짐, 다시 누르면 복구)"/>
                <WrapPanel>
                    <WrapPanel.Resources>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Padding" Value="12,6"/>
                            <Setter Property="Margin" Value="0,4,8,0"/>
                        </Style>
                    </WrapPanel.Resources>
                    <ToggleButton IsChecked="{Binding FaultDisconnect}" Content="연결 끊김" ToolTip="소켓 강제 종료 → 브로커가 Last Will(offline) 발행. 끊긴 동안의 메시지는 유실"/>
                    <ToggleButton IsChecked="{Binding FaultDelay}" Content="전송 지연 3초" ToolTip="모든 발행을 3초 늦춤 (ts는 생성 시각 유지)"/>
                    <ToggleButton IsChecked="{Binding FaultShuffle}" Content="순서 뒤섞기" ToolTip="발행마다 0~250ms 무작위 지연 + 5% 중복 재전송"/>
                    <ToggleButton IsChecked="{Binding FaultAnomaly}" Content="이상값 송신" ToolTip="온도 999.9(측정 범위 밖), 전류 quality bad"/>
                    <ToggleButton IsChecked="{Binding FaultJam}" Content="물건 걸림" ToolTip="벨트 중간 물건이 멈춤 → 출구 미감지, 뒤 물건 적체, 전류 +1.2A"/>
                    <ToggleButton IsChecked="{Binding FaultMotor}" Content="모터 정지" ToolTip="state/run = fault, 속도 0"/>
                </WrapPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="0,8,8,2" Text="로봇 셀 장애 (OPC UA)"/>
                <WrapPanel>
                    <WrapPanel.Resources>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Padding" Value="12,6"/>
                            <Setter Property="Margin" Value="0,4,8,0"/>
                        </Style>
                    </WrapPanel.Resources>
                    <ToggleButton IsChecked="{Binding FaultRobotNetwork}" Content="로봇 통신 끊김" ToolTip="OPC UA 중계(4840→4841)를 끊음: 세션 강제 종료, 새 접속 거부. 로봇 컨트롤러는 계속 동작 (서버 시작 시각 그대로)"/>
                    <ToggleButton IsChecked="{Binding FaultEStop}" Content="비상정지" ToolTip="로봇이 그 자리에서 정지, MotorsOn=false, EmergencyStop=true, 프로그램 정지. 해제 1초 뒤 모터 ON, 멈춘 동작을 이어 감"/>
                    <ToggleButton IsChecked="{Binding FaultVacuum}" Content="흡착 실패" ToolTip="다음 픽에서 진공 ON인데 압력 스위치가 안 잡힘 → 1초 뒤 진공 OFF, 프로그램 정지. 해제하면 재시도"/>
                    <ToggleButton IsChecked="{Binding FaultEncoder}" Content="관절 엔코더 이상" ToolTip="JointPositions·ActualPosition의 StatusCode = BadSensorFailure (값은 마지막 값), 로봇은 계속 움직임"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 송신 로그: 서버가 "보낸 것". 트윈이 "받은 것"과 비교하는 기준 -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" VerticalAlignment="Center">
                <Run Text="송신 로그"/> <Run Foreground="#666" Text="(누적"/><Run Foreground="#666" Text="{Binding SentCount, Mode=OneWay}"/><Run Foreground="#666" Text="건, 최근 1000건 표시)"/>
            </TextBlock>
            <Button DockPanel.Dock="Right" Content="지우기" Padding="10,2" Click="OnClearLog"/>
            <ToggleButton DockPanel.Dock="Right" Content="일시정지" Padding="10,2" Margin="0,0,6,0" IsChecked="{Binding Paused}"/>
        </DockPanel>

        <ListView ItemsSource="{Binding Log}" FontFamily="Consolas" FontSize="12"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="시각" Width="95" DisplayMemberBinding="{Binding Time, StringFormat=HH:mm:ss.fff}"/>
                    <GridViewColumn Header="토픽" Width="280" DisplayMemberBinding="{Binding Topic}"/>
                    <GridViewColumn Header="QoS" Width="40" DisplayMemberBinding="{Binding Qos}"/>
                    <GridViewColumn Header="R" Width="50" DisplayMemberBinding="{Binding Retained}"/>
                    <GridViewColumn Header="장애 처리" Width="170" DisplayMemberBinding="{Binding Note}"/>
                    <GridViewColumn Header="페이로드" Width="500" DisplayMemberBinding="{Binding Payload}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
