<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unity(트윈)가 쓰는 외부 DLL을 NuGet에서 받아 Twin/Assets/Plugins로 복사하는 전용 프로젝트.
       코드는 없다. 버전은 여기서만 관리하고, 복사된 DLL은 Shared DLL과 마찬가지로 커밋하지 않는다.

       MQTTnet: 서버는 5.x를 쓰지만 5.x는 net8.0/net10.0 전용이라 Unity에서 쓸 수 없다.
       4.3.x의 netstandard2.1 빌드를 쓴다 (두 쪽은 MQTT 프로토콜로만 통신하므로 버전 차이는 무관). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
  </ItemGroup>

  <PropertyGroup>
    <UnityMqttDir>$(MSBuildProjectDirectory)/../../Twin/Assets/Plugins/MQTTnet</UnityMqttDir>
  </PropertyGroup>
  <Target Name="CopyToUnity" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)/../../Twin/Assets')">
    <MakeDir Directories="$(UnityMqttDir)" />
    <Copy SourceFiles="$(OutDir)MQTTnet.dll" DestinationFolder="$(UnityMqttDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
